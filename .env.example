# sprechwerk — Beispiel für die Umgebung
#
# Alles hier ist optional: ohne Angabe gelten die Vorgaben. Kopieren nach
# `.env` (docker compose liest sie) oder die Werte direkt setzen. Dieselben
# Werte stehen auch in `sprechwerk.toml`; ausführlich beschrieben in README.md
# → Betrieb. `sprechwerk beispiel` gibt eine vollständige TOML-Vorlage aus.

# --- Server ---------------------------------------------------------------
SPRECHWERK_NAME=Sprechwerk
# UDP-Port für Sprache und Text (der einzige Port nach außen).
SPRECHWERK_PORT=7443
SPRECHWERK_BIND=0.0.0.0
# Leer = jeder darf beitreten. Gesetzt = Passwort beim ersten Verbinden.
#SPRECHWERK_PASSWORT=
# Rolle neuer Mitglieder: mitglied (offen) oder gast (nur zuhören).
SPRECHWERK_STANDARD_ROLLE=mitglied
# Datenverzeichnis: Datenbank, Zertifikat, Sicherungen, Lebenszeichen.
SPRECHWERK_DATEN=/data
# Texte nach so vielen Tagen löschen; 0 = unbegrenzt.
SPRECHWERK_AUFBEWAHRUNG_TAGE=0
# Steuerrahmen je Verbindung und Sekunde, darüber wird getrennt.
SPRECHWERK_RAHMEN_JE_SEKUNDE=100
# bbr (gleichmäßiger für Sprache) oder cubic.
SPRECHWERK_STAUKONTROLLE=bbr
# Sendepuffer für Sprache in KiB — klein halten: verwerfen statt anstauen.
SPRECHWERK_SPRACHPUFFER_KIB=64

# --- Sicherung ------------------------------------------------------------
SPRECHWERK_SICHERUNG_AKTIV=1
SPRECHWERK_SICHERUNG_INTERVALL_MINUTEN=1440
SPRECHWERK_SICHERUNG_BEHALTEN=14
#SPRECHWERK_SICHERUNG_VERZEICHNIS=/data/sicherungen

# --- Verwaltung -----------------------------------------------------------
# Steuerkanal für die Konsole (`sprechwerk stand`, `sprechwerk rolle …`), nur
# auf 127.0.0.1; Zugang über <daten>/verwaltung.schluessel.
SPRECHWERK_VERWALTUNG_AKTIV=1
SPRECHWERK_VERWALTUNG_PORT=7444

# --- Spielnetz (ADR 0016) -------------------------------------------------
# Spiele im Raum freigeben: ein Gastgeber gibt einen Port frei, Teilnehmer
# spiegeln ihn auf 127.0.0.1. Eigene QUIC-Verbindung, Ende zu Ende
# verschlüsselt — der Server vermittelt nur. Vorgabe: aus.
#SPRECHWERK_SPIELNETZ_AKTIV=0
# Durchsatz je Freigabe in kbit/s; 0 = unbegrenzt.
#SPRECHWERK_SPIELNETZ_KBIT=20000

# --- Protokoll ------------------------------------------------------------
# z. B. sprechwerk=debug
SPRECHWERK_LOG=sprechwerk=info

# --- Pfad der Konfigurationsdatei (sprechwerk.toml) -----------------------
#SPRECHWERK_KONFIG=./sprechwerk.toml
