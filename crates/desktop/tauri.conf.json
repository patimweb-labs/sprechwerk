{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sprechwerk",
  "version": "1.2.0",
  "identifier": "de.weppelmann.Sprechwerk",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sprechwerk",
        "width": 1120,
        "height": 760,
        "minWidth": 340,
        "minHeight": 260,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon-512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "publisher": "Patrick Weppelmann",
    "copyright": "Copyright (C) 2026 Patrick Weppelmann",
    "license": "MIT",
    "homepage": "https://github.com/patimweb-labs/sprechwerk",
    "category": "SocialNetworking",
    "shortDescription": "Sprach- und Texträume für Vereine",
    "longDescription": "Selbst gehostete Sprach- und Texträume für Vereine: ein Server, ein UDP-Port, Schlüsseldateien statt Konten."
  }
}
