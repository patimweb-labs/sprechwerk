{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sprechwerk",
  "version": "0.1.0",
  "identifier": "de.weppelmann.Sprechwerk",
  "build": {
    "beforeDevCommand": "npm --prefix ../../ui run dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "npm --prefix ../../ui run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sprechwerk",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png"
    ]
  }
}
