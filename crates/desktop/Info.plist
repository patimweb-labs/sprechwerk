<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ergänzt die Info.plist, die Tauri für macOS erzeugt (Tauri führt diese Datei
  von selbst hinein). Ohne NSMicrophoneUsageDescription beendet macOS die
  Anwendung beim ersten Zugriff aufs Mikrofon, statt zu fragen.
-->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Sprechwerk braucht das Mikrofon, damit du in Sprachräumen reden kannst.</string>
</dict>
</plist>
